OC_BIND=0.0.0.0:8080
OC_PUBLIC_URL=http://localhost:8080
# Unset = SQLite at ./data/opencanvas.db. Set to use MySQL / MariaDB:
# DATABASE_URL=mysql://oc:oc@localhost:3306/opencanvas
OC_HOSTS_FILE=./opencanvas.hosts.toml
# Key-encryption key for secrets at rest (callback tokens): base64 of 32 random bytes,
# e.g. `openssl rand -base64 32`. The server refuses to start without it unless OC_DEV=1.
OC_KEK=
# OC_DEV=1   # development only: allows running without OC_KEK (tokens stored unencrypted)
# OC_MAX_DOC_MB=20   # hard cap on the encoded document; larger updates are refused
