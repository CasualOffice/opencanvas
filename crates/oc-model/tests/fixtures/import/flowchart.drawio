<mxfile host="Electron" version="24.7.17">
  <diagram id="flow-1" name="Checkout flow">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" page="1" pageWidth="850" pageHeight="1100">
      <root>
