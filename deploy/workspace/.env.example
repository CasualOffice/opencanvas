# OpenCanvas Workspace compose settings. Generate real secrets, for example:
#   openssl rand -hex 32     (WS_HOST_SECRET, WS_HOST_API_KEY, WS_TOKEN_KEY, OC_CLUSTER_SECRET)
#   openssl rand -base64 32  (OC_KEK)
# Back this file up with the database: without the secrets saved sessions cannot be read.
WS_PUBLIC_URL=http://localhost:8090
WS_PORT=8090
WS_HOST_SECRET=
WS_HOST_API_KEY=
WS_TOKEN_KEY=
OC_KEK=
OC_CLUSTER_SECRET=
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
