{
  "name": "@opencanvas/block-sdk",
  "version": "0.1.2",
  "description": "Write OpenCanvas blocks: defineBlock, the typed bridge context, script migrations and a test harness.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./harness": "./src/harness.ts",
    "./package.json": "./package.json"
  },
  "files": ["src", "README.md"],
  "scripts": {
    "build-samples": "node scripts/build-samples.mjs",
    "samples:check": "node scripts/build-samples.mjs --check",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24",
    "esbuild": "0.28.2",
    "jsdom": "^31.0.1",
    "typescript": "~5.9",
    "vitest": "^5.1.1"
  }
}
